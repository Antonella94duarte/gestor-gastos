@host = http://localhost:5124

# ---------------------------------------------------------------
# Autenticación
#
# Ejecutar primero el login: los demás requests reutilizan su token
# con {{login.response.body.token}}, sin copiar y pegar nada.
# ---------------------------------------------------------------

### Registro -> 201 (devuelve token)
POST {{host}}/api/auth/registro
Content-Type: application/json

{
  "email": "liz@ejemplo.com",
  "password": "unaClaveSegura123"
}

### Login -> 200
# @name login
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "liz@ejemplo.com",
  "password": "unaClaveSegura123"
}

### Contraseña incorrecta -> 401
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "liz@ejemplo.com",
  "password": "incorrecta"
}

### Email ya registrado -> 409
POST {{host}}/api/auth/registro
Content-Type: application/json

{
  "email": "liz@ejemplo.com",
  "password": "otraClaveSegura456"
}

### Quién soy -> 200
GET {{host}}/api/usuarios/me
Authorization: Bearer {{login.response.body.token}}

### Sin token -> 401
GET {{host}}/api/usuarios/me

# ---------------------------------------------------------------
# Resumen
#
# offsetHoras es la zona del usuario respecto de UTC (-3 para Paraguay
# y Argentina). Sin él, un gasto de las 22:00 del último día del mes se
# cuenta en el mes siguiente.
# ---------------------------------------------------------------

### Balance de septiembre 2026 -> 200
GET {{host}}/api/resumen/mensual?anio=2026&mes=9&offsetHoras=-3
Authorization: Bearer {{login.response.body.token}}

### Balance de octubre 2026 -> 200
GET {{host}}/api/resumen/mensual?anio=2026&mes=10&offsetHoras=-3
Authorization: Bearer {{login.response.body.token}}

### Gastos por categoría en septiembre -> 200
GET {{host}}/api/resumen/por-categoria?desde=2026-09-01T00:00:00-03:00&hasta=2026-09-30T23:59:59-03:00
Authorization: Bearer {{login.response.body.token}}

### Ingresos por categoría -> 200
GET {{host}}/api/resumen/por-categoria?tipo=Ingreso
Authorization: Bearer {{login.response.body.token}}

### Evolución de los últimos 12 meses -> 200
GET {{host}}/api/resumen/evolucion?meses=12&offsetHoras=-3
Authorization: Bearer {{login.response.body.token}}

### Mes inválido -> 400
GET {{host}}/api/resumen/mensual?anio=2026&mes=13
Authorization: Bearer {{login.response.body.token}}

# ---------------------------------------------------------------
# Transacciones
# ---------------------------------------------------------------

### Listar (paginado, 20 por página) -> 200
GET {{host}}/api/transacciones
Authorization: Bearer {{login.response.body.token}}

### Segunda página, de a 5 -> 200
GET {{host}}/api/transacciones?pagina=2&tamano=5
Authorization: Bearer {{login.response.body.token}}

### Solo ingresos -> 200
GET {{host}}/api/transacciones?tipo=Ingreso
Authorization: Bearer {{login.response.body.token}}

### Septiembre de 2026 -> 200
GET {{host}}/api/transacciones?desde=2026-09-01T00:00:00Z&hasta=2026-09-30T23:59:59Z
Authorization: Bearer {{login.response.body.token}}

### Por categoría -> 200
GET {{host}}/api/transacciones?categoriaId=1
Authorization: Bearer {{login.response.body.token}}

### Obtener una -> 200
GET {{host}}/api/transacciones/1
Authorization: Bearer {{login.response.body.token}}

### Registrar un gasto -> 201
POST {{host}}/api/transacciones
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "monto": 2500.50,
  "fecha": "2026-10-01T13:30:00-03:00",
  "descripcion": "Almuerzo",
  "categoriaId": 1
}

### Registrar un ingreso -> 201
POST {{host}}/api/transacciones
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "monto": 1500000,
  "fecha": "2026-10-01T09:00:00-03:00",
  "descripcion": "Sueldo de septiembre",
  "categoriaId": 9
}

### Actualizar -> 204
PUT {{host}}/api/transacciones/1
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "monto": 3000,
  "fecha": "2026-10-01T13:30:00-03:00",
  "descripcion": "Almuerzo corregido",
  "categoriaId": 1
}

### Eliminar -> 204
DELETE {{host}}/api/transacciones/1
Authorization: Bearer {{login.response.body.token}}

### Monto cero -> 400
POST {{host}}/api/transacciones
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "monto": 0,
  "fecha": "2026-10-01T13:30:00-03:00",
  "descripcion": "Inválida",
  "categoriaId": 1
}

### Categoría de otro usuario o inexistente -> 400
POST {{host}}/api/transacciones
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "monto": 100,
  "fecha": "2026-10-01T13:30:00-03:00",
  "descripcion": "Inválida",
  "categoriaId": 9999
}

### Transacción inexistente o ajena -> 404
GET {{host}}/api/transacciones/9999
Authorization: Bearer {{login.response.body.token}}

# ---------------------------------------------------------------
# Categorías
# ---------------------------------------------------------------

### Listar -> 200
GET {{host}}/api/categorias
Authorization: Bearer {{login.response.body.token}}

### Solo gastos -> 200
GET {{host}}/api/categorias?tipo=Gasto
Authorization: Bearer {{login.response.body.token}}

### Solo ingresos -> 200
GET {{host}}/api/categorias?tipo=Ingreso
Authorization: Bearer {{login.response.body.token}}

### Obtener una -> 200
GET {{host}}/api/categorias/1
Authorization: Bearer {{login.response.body.token}}

### Crear categoría de gasto -> 201
POST {{host}}/api/categorias
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "nombre": "Mascotas",
  "tipo": "Gasto"
}

### Crear categoría de ingreso -> 201
POST {{host}}/api/categorias
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "nombre": "Alquileres",
  "tipo": "Ingreso"
}

### Renombrar -> 204
PUT {{host}}/api/categorias/1
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "nombre": "Supermercado",
  "tipo": "Gasto"
}

### Nombre repetido en la misma cuenta -> 409
POST {{host}}/api/categorias
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "nombre": "Comida",
  "tipo": "Gasto"
}

### Eliminar categoría con transacciones -> 409
DELETE {{host}}/api/categorias/1
Authorization: Bearer {{login.response.body.token}}

### Sin el campo tipo -> 400
POST {{host}}/api/categorias
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "nombre": "Sin tipo"
}

### Categoría inexistente o ajena -> 404
GET {{host}}/api/categorias/9999
Authorization: Bearer {{login.response.body.token}}
